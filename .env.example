# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Upstream chatbot the proxy guards. "anthropic" calls the Anthropic API directly;
# "openai" forwards to any OpenAI-compatible server at UPSTREAM_BASE_URL.
UPSTREAM_MODE=anthropic
UPSTREAM_MODEL=claude-sonnet-5
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=

# Small fast model used for the input judge and output safety judge.
JUDGE_MODEL=claude-haiku-4-5-20251001

# Set false to run deterministic guards only (no LLM judge calls).
JUDGES_ENABLED=true

RXGUARD_DB=data/rxguard.db
